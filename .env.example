# EnterpriseGuard WAF - environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://wafuser:waf123@localhost/wafdb

# Redis connection string
REDIS_URL=redis://localhost:6379

# JWT signing secret - use a long random string, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change_this_to_a_long_random_string

# Runtime environment: "development" or "production"
# production: /docs, /redoc and /openapi.json are disabled, CORS falls back
# to CORS_ORIGINS only, and startup REFUSES to run with COOKIE_SECURE=false
# or a short/placeholder SECRET_KEY.
# ENVIRONMENT=production

# WAF mode: "detection" logs only, "prevention" blocks
WAF_MODE=prevention

# Comma-separated IPs of reverse proxies you trust to set X-Forwarded-For.
# Leave empty unless you run behind a proxy, otherwise clients can spoof
# their IP and bypass rate limiting / blocklists / autoban.
# Example: TRUSTED_PROXIES=127.0.0.1,10.0.0.1
TRUSTED_PROXIES=

# Set to true when serving over HTTPS (marks auth cookies Secure)
COOKIE_SECURE=false